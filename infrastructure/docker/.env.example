# .env.example — Copy to .env on the server and fill in secrets
# NEVER commit the actual .env to git

# ---- OpenProject ----
DOMAIN_NAME=projects.axinagroup.com
OPENPROJECT_SECRET_KEY_BASE=  # generate with: openssl rand -hex 64
OPENPROJECT_DB_PASSWORD=       # generate with: openssl rand -hex 32
LETSENCRYPT_EMAIL=

# ---- Remote MCP Server ----
# API key protecting the /mcp nginx endpoint — generate with: openssl rand -hex 32
MCP_API_KEY=

# OpenProject admin API token (for MCP server to call OpenProject API)
# Generate in: My Account → Access tokens → + API token
OPENPROJECT_ADMIN_API_KEY=

# ---- S3 Attachment Storage ----
# Configured via /data/openproject/config/configuration.yml (IAM role — no keys needed)

# ---- SES SMTP Configuration ----
# To get credentials: AWS Console -> SES -> SMTP Settings -> Create My SMTP Credentials
# NOTE: SMTP password is NOT the IAM secret key — it's a derived value from the SES console
SMTP_USERNAME=
SMTP_PASSWORD=
