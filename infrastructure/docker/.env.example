# .env.example — Copy to .env on the server and fill in secrets
# NEVER commit the actual .env to git

# ---- OpenProject ----
DOMAIN_NAME=projects.axinagroup.com
OPENPROJECT_SECRET_KEY_BASE=  # generate with: openssl rand -hex 64
OPENPROJECT_DB_PASSWORD=       # generate with: openssl rand -hex 32
LETSENCRYPT_EMAIL=

# ---- Real-time Collaboration (Hocuspocus) ----
# Shared secret between OpenProject and the Hocuspocus container
# Generate with: openssl rand -hex 32
HOCUSPOCUS_SECRET=

# ---- Remote MCP Server ----
# API key protecting the /mcp nginx endpoint — generate with: openssl rand -hex 32
MCP_API_KEY=

# OpenProject admin API token (for MCP server to call OpenProject API)
# Generate in: My Account → Access tokens → + API token
OPENPROJECT_ADMIN_API_KEY=

# ---- S3 Attachment Storage ----
# Configured via /data/openproject/config/configuration.yml (IAM role — no keys needed)

# ---- SES SMTP Configuration ----
# To get credentials: AWS Console -> SES -> SMTP Settings -> Create My SMTP Credentials
# NOTE: SMTP password is NOT the IAM secret key — it's a derived value from the SES console
SMTP_USERNAME=
SMTP_PASSWORD=

# ---- Nextcloud ----
NC_DB_PASSWORD=        # generate with: openssl rand -hex 32
NC_ADMIN_PASSWORD=     # generate with: openssl rand -hex 16
NC_S3_BUCKET=axina-openproject-files   # shared bucket — Nextcloud uses nextcloud/ prefix
NC_S3_REGION=us-east-1
NC_S3_ACCESS_KEY_ID=   # IAM user: nextcloud-s3 (policy: nextcloud-iam-policy.json)
NC_S3_SECRET_ACCESS_KEY=

# ---- AXERP (ERPNext v16) ----
AXERP_SITE_NAME=erp.axinagroup.com   # Frappe site name — must match the domain
AXERP_ADMIN_PASSWORD=                # generate with: openssl rand -hex 16
# OPENPROJECT_DB_PASSWORD is reused as the PostgreSQL superuser password for site creation
# (openproject user is a PG superuser and can create new databases/roles)
