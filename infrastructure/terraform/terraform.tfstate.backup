  "outputs": {
    "claude_mcp_command": {
      "value": "claude mcp add --transport sse openproject http://localhost:39127/sse",
      "type": "string"
    },
    "deployment_summary": {
      "value": "\n==============================================\n  OpenProject Deployment Complete\n==============================================\n\n  Web UI:   https://projects.axinagroup.com\n  SSH:      ssh -i ~/.ssh/aws-key-xgccloudcom.pem ec2-user@44.195.198.18\n\nConnect MCP to Claude CLI (via SSM tunnel):\n  1. terraform output instance_id\n  2. ../../scripts/ssm-mcp-tunnel.sh \u003cinstance-id\u003e\n  3. claude mcp add --transport sse openproject http://localhost:39127/sse\n\n==============================================\n",
      "type": "string"
    },
    "domain_name": {
      "value": "https://projects.axinagroup.com",
      "type": "string"
    },
    "instance_id": {
      "value": "i-03a1a1d683b542d47",
      "type": "string"
    },
    "public_ip": {
      "value": "44.195.198.18",
      "type": "string"
    },
    "s3_bucket": {
      "value": "axina-openproject-files",
      "type": "string"
    },
    "s3_bucket_arn": {
      "value": "arn:aws:s3:::axina-openproject-files",
      "type": "string"
    },
    "ssh_command": {
      "value": "ssh -i ~/.ssh/aws-key-xgccloudcom.pem ec2-user@44.195.198.18",
      "type": "string"
    },
    "ssm_tunnel_command": {
      "value": "aws ssm start-session --target i-03a1a1d683b542d47 --document-name AWS-StartPortForwardingSession --parameters '{\"portNumber\":[\"39127\"],\"localPortNumber\":[\"39127\"]}'",
      "type": "string"
    }
  },
