POSTGRES_PRISMA_URL=postgresql://papermark:papermark_local_pw@postgres-local:5432/papermark
POSTGRES_PRISMA_URL_NON_POOLING=postgresql://papermark:papermark_local_pw@postgres-local:5432/papermark

